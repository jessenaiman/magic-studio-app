storybook character art for 2D animation. Plain transparent background, no text, labels, frames, shadows or props. Nothing touches the canvas edge. Clean solid silhouette edge with no loose fibres or specks. Every drawing of the character keeps the same design, palette, proportions and scale."}}, {"command": "selection.set", "params": {"ids": ["$1160.id"]}}, {"command": "object.fill", "params": {"swatch": "[None]"}}, {"command": "object.stroke", "params": {"swatch": "[None]", "weight": 0}}, {"command": "object.textFrameOptions", "params": {"inset": 0, "verticalJustification": "top", "ids": ["$1160.id"]}}, {"command": "type.char", "params": {"attrs": {"fontFamily": "Newsreader", "size": 15, "fill": "Ink", "tracking": 0, "leading": {"kind": "points", "value": 22}}}}, {"command": "type.para", "params": {"attrs": {"align": "left"}}}, {"command": "object.label", "params": {"label": "char_exact_prompt", "ids": ["$1160.id"]}}, {"command": "frame.create", "params": {"spread": 2, "rect": [874, 742, 1524, 796.0], "content": "text", "text": "Original drawing \u203a generated asset\nGenerated and attached \u00b7 visual review still required"}}, {"command": "selection.set", "params": {"ids": ["$1168.id"]}}, {"command": "object.fill", "params": {"swatch": "[None]"}}, {"command": "object.stroke", "params": {"swatch": "[None]", "weight": 0}}, {"command": "object.textFrameOptions", "params": {"inset": 0, "verticalJustification": "top", "ids": ["$1168.id"]}}, {"command": "type.char", "params": {"attrs": {"fontFamily": "Caveat", "size": 20.8, "fill": "Pencil", "tracking": 0}}}, {"command": "type.para", "params": {"attrs": {"align": "left"}}}, {"command": "object.label", "params": {"label": "char_prompt_foot", "ids": ["$1168.id"]}}, {"command": "frame.create", "params": {"spread": 2, "rect": [850, 825, 1550, 847], "content": "text", "text": "GEOMETRY TO PRESERVE"}}, {"command": "selection.set", "params": {"ids": ["$1176.id"]}}, {"command": "object.fill", "params": {"swatch": "[None]"}}