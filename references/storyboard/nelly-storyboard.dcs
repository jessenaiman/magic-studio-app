.id"]}}, {"command": "frame.create", "params": {"spread": 0, "rect": [855, 233, 1545, 331], "shape": "rectangle"}}, {"command": "selection.set", "params": {"ids": ["$173.id"]}}, {"command": "object.fill", "params": {"swatch": "[None]"}}, {"command": "object.stroke", "params": {"swatch": "Hair", "weight": 1.1, "type": {"kind": "dashed", "pattern": [6, 4]}}}, {"command": "frame.create", "params": {"spread": 0, "rect": [862, 214, 1032, 238], "shape": "rectangle"}}, {"command": "selection.set", "params": {"ids": ["$177.id"]}}, {"command": "object.fill", "params": {"swatch": "Rust"}}, {"command": "object.stroke", "params": {"swatch": "[None]", "weight": 0}}, {"command": "object.dropShadow", "params": {"on": true, "distance": 2, "size": 4, "opacity": 0.3, "angle": 125, "globalLight": false, "ids": ["$177.id"]}}, {"command": "frame.create", "params": {"spread": 0, "rect": [866, 218, 1028, 234], "shape": "rectangle"}}, {"command": "selection.set", "params": {"ids": ["$182.id"]}}, {"command": "object.fill", "params": {"swatch": "[None]"}}, {"command": "object.stroke", "params": {"swatch": "Cream", "weight": 1, "type": {"kind": "dashed", "pattern": [6, 4]}}}, {"command": "object.opacity", "params": {"opacity": 70, "ids": ["$182.id"]}}, {"command": "frame.create", "params": {"spread": 0, "rect": [872, 216, 1022, 236], "content": "text", "text": "D01 / OVERALL DESIGN"}}, {"command": "selection.set", "params": {"ids": ["$187.id"]}}, {"command": "object.fill", "params": {"swatch": "[None]"}}, {"command": "object.stroke", "params": {"swatch": "[None]", "weight": 0}}, {"command": "object.textFrameOptions", "params": {"inset": 0, "verticalJustification": "center", "ids": ["$187.id"]}}, {"command": "type.char", "params": {"attrs": {"fontFamily": "Fraunces", "size": 11, "fill": "Cream", "tracking": 0, "fontStyle": "Bold"}}}, {"command": "type.para", "params": {"attrs": {"align": "center"}}}, {"command": "object.label", "params": {"label": "cover_d01_tag", "ids": ["$187.id"]}}, {"comma