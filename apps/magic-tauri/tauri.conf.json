{
  "$schema": "https://schemas.tauri.app/v2/schema.json",
  "productName": "Magic Studio",
  "identifier": "ai.storyteller.magicstudio",
  "version": "0.17.0",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../magic"
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../magic"
    },
    "frontendDist": "../magic/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "/run/media/**"
          ],
          "requireLiteralLeadingDot": false
        }
      },
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "title": "Magic Studio",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
