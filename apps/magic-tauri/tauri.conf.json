{
  "$schema": "https://schemas.tauri.app/v2/schema.json",
  "productName": "Magic Studio",
  "identifier": "ai.storyteller.magicstudio",
  "version": "0.17.0",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../magic"
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../magic"
    },
    "frontendDist": "../magic/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "media-src": "'self' blob: asset: http://asset.localhost",
        "font-src": "'self' data: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: http://127.0.0.1:* http://localhost:*",
        "frame-src": "'self' blob: http://127.0.0.1:* http://localhost:*",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$APPLOCALDATA/**",
            "$APPCACHE/**"
          ],
          "deny": [
            "**/*token*",
            "**/*secret*",
            "**/*credential*",
            "**/*password*",
            "**/*.pem",
            "**/*.key",
            "**/id_rsa*",
            "**/id_ed25519*",
            "**/.env",
            "**/.env.*"
          ],
          "requireLiteralLeadingDot": true
        }
      },
      "capabilities": [
        "default",
        "desktop-capability"
      ],
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "media-src": "'self' blob: asset: http://asset.localhost",
        "font-src": "'self' data: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: http://127.0.0.1:* http://localhost:* ws://localhost:1420 ws://localhost:1421",
        "frame-src": "'self' blob: http://127.0.0.1:* http://localhost:*",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    },
    "windows": [
      {
        "title": "Magic Studio",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
