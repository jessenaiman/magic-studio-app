{
  "$schema": "https://schemas.tauri.app/v2/schema.json",
  "productName": "Magic Studio",
  "identifier": "ai.storyteller.magicstudio",
  "version": "0.17.0",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "/run/media/**"
          ],
          "requireLiteralLeadingDot": false
        }
      },
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "title": "Magic Studio",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  },
  "plugins": {
    "cli": {
      "description": "Magic Studio \u2014 CommandSpec registry CLI (162 commands via magic-engine)",
      "args": [
        {
          "name": "project",
          "long": "project",
          "takesValue": true,
          "description": "Open .magic project"
        },
        {
          "name": "view",
          "takesValue": true,
          "possibleValues": [
            "projects",
            "storyboard",
            "lyrics",
            "animation",
            "motion",
            "studio"
          ],
          "description": "Start on a view"
        },
        {
          "name": "control",
          "takesValue": true,
          "description": "--control PORT loopback bridge (127.0.0.1 + token)"
        },
        {
          "name": "lyrics",
          "description": "Open Lyrics (song folder, no .magic)"
        }
      ],
      "subcommands": {
        "mcp": {
          "description": "Serve MCP on stdio / --bridge"
        },
        "ui": {
          "description": "Inspect live window",
          "args": [
            {
              "name": "action",
              "possibleValues": [
                "inspect",
                "elements",
                "view",
                "feedback"
              ]
            }
          ]
        },
        "storyboard": {
          "description": "Storyboard document",
          "subcommands": {
            "pages": {},
            "slots": {},
            "set": {},
            "export": {}
          }
        },
        "commands": {
          "description": "List engine commands"
        },
        "exec": {
          "description": "Run one command",
          "args": [
            {
              "name": "id",
              "index": 1,
              "takesValue": true
            }
          ]
        },
        "describe": {
          "description": "Describe one command",
          "args": [
            {
              "name": "id",
              "index": 1,
              "takesValue": true
            }
          ]
        }
      }
    }
  }
}
