  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "exclude": ["apps/src-tauri/ui/vendor"],
